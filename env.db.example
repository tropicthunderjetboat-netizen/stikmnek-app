# Copy this file to `.env.db.local` and fill in your real database password.
# Never commit `.env.db.local` (it is ignored via *.local).
#
# Where to get the URL:
#   Supabase Dashboard → your project → Settings → Database
#   → Connection string → URI → use "Direct connection" (port 5432)
#
# Example shape:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.abcdefghijklmnop.supabase.co:5432/postgres

DATABASE_URL=
